# I-Sora web — environment variables
# Copy to .env.local for local dev, and set the same in the Vercel dashboard.

# Public site URL (used for QR deep-links + pairing instructions spoken by the device).
# Local dev: http://localhost:3000 — Production: https://isora.vercel.app (or your custom domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Phase 2+). Anon key is safe to expose; service-role key is SERVER-ONLY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
